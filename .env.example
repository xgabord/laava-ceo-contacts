PORT=3005
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-16-characters
IMAP_HOST=your-imap-host
IMAP_PORT=993
IMAP_USER=your-mail-address
IMAP_PASSWORD=your-imap-password
POLL_SECONDS=60

# Google Contacts sync: keep disabled until Code.gs is updated and redeployed.\n# When enabled, the IMAP UID cursor is stored in Google Apps Script Properties.\n# First activation starts from the then-current INBOX position (no historical imports).
GCONTACTS_SYNC_ENABLED=false
GCONTACTS_SCRIPT_URL=
GCONTACTS_SCRIPT_SECRET=
